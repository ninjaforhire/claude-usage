{
  "name": "hotfix-ops-usage",
  "displayName": "HotFix Ops Usage",
  "description": "Local Claude and Codex usage, account capacity, costs, sessions, and operational health inside VS Code.",
  "version": "1.4.0",
  "publisher": "HotFixOps",
  "author": {
    "name": "HotFix Ops",
    "url": "https://hotfixops.com/"
  },
  "license": "MIT",
  "homepage": "https://github.com/ninjaforhire/claude-usage",
  "repository": {
    "type": "git",
    "url": "https://github.com/ninjaforhire/claude-usage"
  },
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "usage",
    "tokens",
    "cost",
    "dashboard",
    "anthropic",
    "codex",
    "hotfix-ops"
  ],
  "icon": "resources/icon.png",
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeUsageSidebar",
          "title": "HotFix Ops Usage",
          "icon": "resources/icon.png"
        }
      ]
    },
    "views": {
      "claudeUsageSidebar": [
        {
          "type": "webview",
          "id": "claudeUsage.dashboard",
          "name": "Dashboard"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeUsage.open",
        "title": "HotFix Ops: Open Usage Dashboard"
      },
      {
        "command": "claudeUsage.rescan",
        "title": "HotFix Ops: Rescan Usage"
      },
      {
        "command": "claudeUsage.restart",
        "title": "HotFix Ops: Restart Usage Server"
      },
      {
        "command": "claudeUsage.showLogs",
        "title": "HotFix Ops: Show Usage Logs"
      }
    ],
    "configuration": {
      "title": "HotFix Ops Usage",
      "properties": {
        "claudeUsage.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Path to a Python interpreter (>=3.9). Empty = auto-discover (claude-usage on PATH, then python3, then python)."
        },
        "claudeUsage.cliPath": {
          "type": "string",
          "default": "",
          "description": "Path to a claude-usage clone's cli.py. Empty = auto-discover (Homebrew claude-usage shim, then this clone, then ~/.claude-usage)."
        },
        "claudeUsage.port": {
          "type": "number",
          "default": 0,
          "description": "Bind port for the dashboard server. 0 = auto-pick a free port."
        }
      }
    }
  },
  "scripts": {
    "copy-python": "node scripts/copy-python.js",
    "vscode:prepublish": "npm run copy-python && tsc -p .",
    "compile": "tsc -p .",
    "watch": "tsc -p . -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npx @vscode/vsce package --no-dependencies",
    "publish": "npx @vscode/vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.94.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
